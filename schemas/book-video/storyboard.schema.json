{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/book-video/storyboard.schema.json",
  "title": "Book Video Storyboard",
  "type": "object",
  "required": ["version", "title", "format", "voice", "scenes"],
  "properties": {
    "version": { "const": "0.1" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "format": {
      "type": "object",
      "required": ["aspect_ratio", "resolution", "target_duration_seconds"],
      "properties": {
        "aspect_ratio": { "enum": ["9:16", "16:9", "1:1"] },
        "resolution": { "type": "string", "default": "1080x1920" },
        "target_duration_seconds": { "type": "number", "minimum": 15, "maximum": 600 },
        "fps": { "type": "integer", "minimum": 24, "maximum": 60, "default": 30 }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "required": ["language", "style"],
      "properties": {
        "language": { "type": "string", "default": "zh-CN" },
        "style": { "type": "string" },
        "speaker": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.7, "maximum": 1.5, "default": 1.0 }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "style": { "type": "string" },
        "volume_db": { "type": "number", "default": -24 }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration_seconds", "narration", "visual", "onscreen_text"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene_[0-9]{3}$" },
          "duration_seconds": { "type": "number", "minimum": 2, "maximum": 30 },
          "narration": { "type": "string", "minLength": 1 },
          "visual": {
            "type": "object",
            "required": ["type", "prompt"],
            "properties": {
              "type": { "enum": ["image", "video", "title_card", "quote_card", "broll"] },
              "prompt": { "type": "string", "minLength": 1 },
              "negative_prompt": { "type": "string" },
              "motion": { "type": "string" }
            },
            "additionalProperties": false
          },
          "onscreen_text": { "type": "string" },
          "transition": { "enum": ["cut", "fade", "dissolve", "zoom"], "default": "cut" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
